{
  "name": "beeboscore-lite",
  "productName": "BeeboScore",
  "version": "1.5.2",
  "description": "BeeboScore: the scoreboard, game formats, start.gg and OBS overlays for fighting game streams — the essentials only.",
  "author": {
    "name": "Beebo"
  },
  "license": "MIT",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "build:streamdeck": "cd streamdeck && npm install && npm run build",
    "predist": "node tools/set-unpack-dir.js && npm run build:streamdeck && node tools/portable-cache.js",
    "dist": "electron-builder --win portable --x64 --publish never",
    "predist:setup": "npm run build:streamdeck",
    "dist:setup": "electron-builder --win nsis --x64 --publish never",
    "predist:beta": "npm run build:streamdeck && node tools/portable-cache.js",
    "dist:beta": "electron-builder --win portable --x64 --publish never -c.appId=com.t1fgc.beeboscore.lite.beta -c.productName=\"BeeboScore Testbuild\" -c.extraMetadata.name=beeboscore-lite-testbuild -c.extraMetadata.productName=\"BeeboScore Testbuild\" '-c.portable.artifactName=BeeboScore Testbuild ${version}.${ext}' -c.portable.unpackDirName=BeeboScoreTestbuild",
    "test": "node --test test/*/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.t1fgc.beeboscore.lite",
    "productName": "BeeboScore",
    "copyright": "Copyright © 2026 Beebo",
    "artifactName": "BeeboScore-Setup-${version}.${ext}",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "desktop"
    },
    "files": [
      "server.js",
      "package.json",
      "README.md",
      "CHANGELOG.md",
      "lib/**",
      "public/**",
      "overlays/**",
      "startgg-oauth.json",
      "desktop/*.js",
      "desktop/icon.*",
      "!**/*.map",
      "!**/{CHANGELOG.md,README.md,readme.md,*.d.ts,test,tests,__tests__,docs,example,examples}/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.ico",
      "legalTrademarks": "Beebo"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BeeboScore",
      "installerIcon": "desktop/icon.ico",
      "uninstallerIcon": "desktop/icon.ico",
      "uninstallDisplayName": "BeeboScore",
      "deleteAppDataOnUninstall": false,
      "include": "desktop/installer.nsh"
    },
    "portable": {
      "artifactName": "BeeboScore-${version}.${ext}",
      "unpackDirName": "BeeboScore-1.5.2",
      "useZip": true,
      "splashImage": "desktop/splash.bmp"
    },
    "extraResources": [
      {
        "from": "streamdeck/dist/com.t1fgc.beeboscore.lite.streamDeckPlugin",
        "to": "streamdeck/com.t1fgc.beeboscore.lite.streamDeckPlugin"
      }
    ]
  }
}
